{
    "name": "rczy/phipe",
    "type": "library",
    "description": "PHiPe: Lightweight data processing pipelines",
    "keywords": ["pipeline", "data-processing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Bálint Bérczy"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Rczy\\Phipe\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "tests": "./vendor/bin/phpunit --testdox --display-warnings tests"
    }
}
